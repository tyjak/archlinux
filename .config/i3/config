    background #002b36
    statusline #93a1a1
    focused_workspace #eee8d5 #859900 #eee8d5
    active_workspace #fdf6e3 #6c71c4 #fdf6e3
    inactive_workspace #073642 #eee8d5 #002b36
    urgent_workspace #d33682 #d33682 #fdf6e3
  }
  strip_workspace_numbers yes
  tray_output primary
  # separator_symbol " "
}

